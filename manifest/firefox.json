{
  "manifest_version": 3,
  "name": "AI Sidebar Writing Assistant",
  "version": "1.4.0",
  "description": "A Gemini-style AI chat sidebar extension.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "sidebar_action": {
    "default_title": "AI Sidebar",
    "default_panel": "sidepanel.html",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-sidebar-writing-assistant@example.com",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Open AI Sidebar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
